# Brevo Transactional Email API
# Get your key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key-here

# Sender address (must be verified in Brevo)
EMAIL_SENDER_NAME="Blackford"
EMAIL_SENDER_ADDRESS=enquiries@yourdomain.com

# Admin notification recipient
EMAIL_ADMIN_ADDRESS=admin@yourdomain.com

# Public site URL (used for metadata and OG tags)
NEXT_PUBLIC_SITE_URL=https://blackford.com
